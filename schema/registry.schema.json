{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HatiFlash/novydeck-plugins/schema/registry.schema.json",
  "title": "NovyDeck Community Plugin Registry",
  "type": "object",
  "required": ["schema", "plugins"],
  "properties": {
    "schema": {"const": 1},
    "plugins": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "plugin": {
      "type": "object",
      "required": ["id", "name", "author", "version", "description", "homepage", "download", "sha256", "license", "tested_decks", "min_novydeck"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "name": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,7}$", "maxLength": 64},
        "description": {"type": "string", "minLength": 1},
        "description_fr": {"type": "string"},
        "homepage": {"type": "string", "format": "uri", "pattern": "^https://"},
        "download": {"type": "string", "format": "uri", "pattern": "^https://", "anyOf": [{"pattern": "\\.streamDeckPlugin$"}, {"pattern": "\\.zip$"}]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "license": {"type": "string", "minLength": 1},
        "tested_decks": {"type": "array", "items": {"type": "string"}},
        "min_novydeck": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,7}$", "maxLength": 64},
        "uuid": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "category": {"enum": ["system", "audio", "streaming", "productivity", "smart-home", "communication", "gaming", "utilities"]},
        "summary": {"type": "string", "maxLength": 140},
        "summary_fr": {"type": "string", "maxLength": 140},
        "icon": {"type": "string", "format": "uri", "pattern": "^https://.*\\.png(?:\\?.*)?$"},
        "screenshots": {"type": "array", "maxItems": 6, "items": {"type": "string", "format": "uri", "pattern": "^https://.*\\.(?:png|jpe?g)(?:\\?.*)?$"}},
        "actions": {"type": "array", "maxItems": 100, "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "name_fr": {"type": "string"}}, "additionalProperties": false}},
        "tags": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
        "requires": {"type": "string", "maxLength": 200},
        "tested_by_novydeck": {"type": "object", "required": ["version", "date"], "properties": {"version": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,7}$"}, "date": {"type": "string", "format": "date"}}, "additionalProperties": false}
      },
      "additionalProperties": false
    }
  }
}
